# ── Anthropic (phrase generation, intent matching, translation) ─────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional model overrides
# SMART_MODEL=claude-opus-5          # phrase-pack generation
# FAST_MODEL=claude-haiku-4-5        # in-call intent matching / live translation

# ── ElevenLabs ───────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=...
# Voice used for all synthesized speech (pick a natural Japanese-capable voice)
ELEVENLABS_VOICE_ID=...
# Agent mode (ElevenLabs Conversational AI + native Twilio integration):
ELEVENLABS_AGENT_ID=...
ELEVENLABS_AGENT_PHONE_NUMBER_ID=...
# Buddy Call: a SECOND Conversational AI agent (friendly check-in persona).
# Create it with the prompt from src/lib/buddy.ts → buddyPromptTemplate(),
# set its First message to {{first_message}}, same phone number + webhook.
ELEVENLABS_BUDDY_AGENT_ID=...
# Affirmation Call: a THIRD agent (warm, soothing message delivery).
# Prompt from src/lib/affirm.ts → affirmationPromptTemplate(), First
# message {{first_message}}, same phone number + webhook.
ELEVENLABS_AFFIRMATION_AGENT_ID=...
# Optional FOURTH agent: the Ah Beng affirmation persona (male voice,
# heavy Singlish, English + Chinese only). Prompt from
# src/lib/affirm.ts → ahBengPromptTemplate().
ELEVENLABS_AHBENG_AGENT_ID=...
# Optional: run Live Chat on a faster LLM than the agent's dashboard model
# (phone calls keep the dashboard model). Use the exact name from the
# agent's LLM dropdown, e.g. "claude-haiku-4-5". Requires the "LLM"
# override to be enabled in the agent's Settings → Overrides.
# ELEVENLABS_CHAT_LLM=claude-haiku-4-5
# Post-call webhook HMAC secret (from the ElevenLabs webhooks settings page)
ELEVENLABS_WEBHOOK_SECRET=...
# Optional model overrides
# ELEVENLABS_PRERENDER_MODEL=eleven_multilingual_v2
# ELEVENLABS_REALTIME_MODEL=eleven_flash_v2_5

# ── Twilio (telephony) ───────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# Your Twilio number, E.164. Enable Japan (+81) in Twilio geo permissions.
TWILIO_FROM_NUMBER=+1...

# ── Deployment ───────────────────────────────────────────────────────────────
# Public origin of this app; Twilio must be able to reach it.
# Locally, use an ngrok/cloudflared tunnel URL.
PUBLIC_BASE_URL=https://your-app.vercel.app

# Vercel Blob (durable audio storage). Omit locally to use .data/audio instead.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# Vercel KV / Upstash Redis (reservation + phrase-library metadata).
# Omit locally to use a .data/store.json file instead.
KV_REST_API_URL=https://...upstash.io
KV_REST_API_TOKEN=...

# Protects the scheduled-call cron endpoint (/api/cron/dispatch). Set any
# random string; Vercel Cron sends it automatically as a Bearer token.
CRON_SECRET=...

# ── Confirmation emails (optional, via resend.com) ───────────────────────────
# When set, the requester gets an email with the outcome + full call
# transcript after each call. FROM address must be on a domain verified in
# Resend (or use onboarding@resend.dev for testing).
RESEND_API_KEY=re_...
CONFIRMATION_FROM_EMAIL=callagent@yourdomain.com
# Display name shown in inboxes ("Name <email>")
CONFIRMATION_FROM_NAME=Agentic Concierge

# PIN for the dashboard's Admin mode (deleting reservations, credit costs).
# Admin is disabled until this is set.
ADMIN_PIN=1234
# When Google login is configured, Admin additionally requires being signed
# in with this Google account (PIN alone is no longer enough).
# ADMIN_EMAIL=markh.tan@gmail.com

# ── Google sign-in (optional — guest mode works without it) ──────────────────
# Google Cloud Console → APIs & Services → Credentials → Create OAuth client ID
# → Web application. Add your origins (https://your-app.vercel.app and
# http://localhost:3000) under "Authorized JavaScript origins" — no redirect
# URI is needed. NEXT_PUBLIC_ prefix is required (the sign-in button runs in
# the browser).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
# Secret for signing session cookies. Any long random string:
#   openssl rand -hex 32
AUTH_SECRET=...
